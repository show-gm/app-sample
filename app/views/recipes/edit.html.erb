<h1>レシピの編集</h1>

<%= form_with(model: @recipe, local: true) do |form| %>

  <div>
    <%= form.label :image, "料理の画像" %>  <%= form.file_field :image %>
  </div>

<% end %>

<%= form_with(model: @recipe, local: true) do |form| %>
    <div style="margin-bottom: 8px;">
      <%= form.label :content, "レシピタイトル" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= form.text_area :content, rows: 5, style: "width: 100%; max-width: 200px;" %>
    </div>

    <div style="margin-bottom: 8px;">
      <%= form.label :content, "必要な具材" %>
    </div>

  
    <div style="margin-bottom: 15px;">
      <%= form.text_area :content, rows: 5, style: "width: 100%; max-width: 200px;" %>
    </div>
    
    <div style="margin-bottom: 8px;">
      <%= form.label :content, "料理手順" %>
    </div>

  
    <div style="margin-bottom: 15px;">
      <%= form.text_area :content, rows: 5, style: "width: 100%; max-width: 200px;" %>
    </div>
    
    <div style="margin-bottom: 8px;">
      <%= form.label :content, "料理にかかる時間" %>
    </div>

  
    <div style="margin-bottom: 15px;">
      <%= form.text_area :content, rows: 5, style: "width: 100%; max-width: 200px;" %>
    </div>
    <div>
      <%= form.submit "更新" %>
    </div>
  <% end %>