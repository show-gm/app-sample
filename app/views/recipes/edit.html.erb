<h1>レシピの編集</h1>

<%= form_with(model: @recipe, local: true) do |form| %>

  <%= render 'shared/error_messages', object: form.object %>

  <%# 📷 料理の画像 %>
  <div style="margin-bottom: 15px;">
    <%= form.label :image, "料理の画像" %><br>
    <%= form.file_field :image %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.label :title, "レシピタイトル" %><br>
    <%= form.text_field :title, style: "width: 100%; max-width: 200px;" %>
  </div>


  
<div style="margin-bottom: 15px;">
  <%= form.label :ingredients, "必要な具材" %><br>
  <%= form.text_area :ingredients, rows: 5, style: "width: 100%; max-width: 200px;" %>
</div>


<div style="margin-bottom: 15px;">
  <%= form.label :description, "料理手順" %><br>
  <%= form.text_area :description, rows: 5, style: "width: 100%; max-width: 200px;" %>
</div>
  <div style="margin-bottom: 15px;">
    <%= form.label :content, "料理にかかる時間（分）" %><br>
    <%= form.number_field :content, style: "width: 100%; max-width: 200px;" %>
  </div>

  <%# 💾 更新ボタン %>
  <div style="margin-top: 20px;">
    <%= form.submit "更新する" %>
  </div>

<% end %>