<%= form_with url: search_recipes_path, method: :get do |f| %>
  <%= f.text_field :keyword, value: params[:keyword], placeholder: "レシピタイトルで検索" %>
  <%= f.submit "検索する" %>
<% end %>
<h1>レシピの詳細</h1>

<div>
  <strong>レシピタイトル</strong>
  <p><%= @recipe.title %></p>
</div>

<div>
  <h3>必要な具材</h3>
<p><%= @recipe.ingredients %></p>
</div>


<div>
  <h3>料理手順</h3>
<p><%= @recipe.description %></p>
</div>

<div>
  <strong>料理にかかる時間（分）</strong>
  <p><%= @recipe.content %> 分</p>
</div>

<hr>
<%= render "favorite_button", recipe: @recipe %>

<!-- 編集画面へジャンプするリンク -->
<p><%= link_to "編集する", edit_recipe_path(@recipe) %></p>

<p><%= link_to "一覧に戻る", recipes_path %></p>