<h1>レシピの詳細</h1>

<div>
  <strong>レシピタイトル</strong>
  <p><%= @recipe.title %></p>
</div>

<div>
  <h3>必要な具材</h3>
<p><%= @recipe.ingredients %></p>
</div>


<div>
  <h3>料理手順</h3>
<p><%= @recipe.description %></p>
</div>

<div>
  <strong>料理にかかる時間（分）</strong>
  <p><%= @recipe.content %> 分</p>
</div>

<hr>

<!-- 編集画面へジャンプするリンク -->
<p><%= link_to "編集する", edit_recipe_path(@recipe) %></p>

<p><%= link_to "一覧に戻る", root_path %></p>