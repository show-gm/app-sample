<h1>レシピ新規投稿</h1>

<%= form_with model: @recipe, local: true do |f| %>

  <%= render 'shared/error_messages', object: f.object %>
  <div class="form-group">
    
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>
  
  <div>
    <%= f.label :content, "必要な具材" %><br>
    <%= f.text_area :content %>
  </div>
  
  <div>
    <%= f.label :content, "料理手順" %><br>
    <%= f.text_area :content %>
  </div>



  <div>
  <%= f.label :content, "料理にかかる時間" %><br>
  <%= f.text_area :content %>
</div>

  <div>
  <div>
    <%= f.label :image, "料理の画像" %>
    <%= f.file_field :image %>
  </div>
  <%# ------------------ %>
    <%= f.submit "登録" %>
  </div>
<% end %>
