<h1>レシピ新規投稿</h1>

<%= form_with model: @recipe, local: true do |form| %>

  <%= render 'shared/error_messages', object: form.object %>
  <div class="form-group">
    
  <div>
    <%= form.label :title, "タイトル" %><br>
    <%= form.text_field :title %>
  </div>
  
  <div>
    <%= form.label :content, "必要な具材" %><br>
    <%= form.text_area :content %>
  </div>
  
  <div>
    <%= form.label :content, "料理手順" %><br>
    <%= form.text_area :content %>
  </div>



  <div style="margin-bottom: 15px;">
    <%= form.label :cooking_time, "料理にかかる時間（分）" %><br>
    <%= form.number_field :cooking_time, style: "width: 100%; max-width: 200px;" %>
  </div>
</div>

  <div>
  <div>
    <%= form.label :image, "料理の画像" %>
    <%= form.file_field :image %>
  </div>
  <%# ------------------ %>
    <%= form.submit "登録" %>
  </div>
<% end %>
