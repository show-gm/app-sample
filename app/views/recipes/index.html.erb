<% if current_user %>
  <p>ようこそ <%= current_user.name %> さん</p>
<% end %>

<div style="margin-bottom: 20px;">
  <%= form_with(url: search_recipes_path, local: true, method: :get) do |form| %>
    <%= form.text_field :keyword, value: params[:keyword], placeholder: "レシピタイトルで検索" %>
    <%= form.submit "検索する" %>
  <% end %>
</div>

<% if user_signed_in? %>  
  <%= button_to "ログアウト", destroy_user_session_path, method: :delete %>
<% end %>

<h1>Your Recipes</h1>

<%= link_to '新しいレシピを投稿する', new_recipe_path %> <% @recipes.each do |recipe| %>
   
  <div>  
   <%= link_to "編集", edit_recipe_path(recipe) %>
   <%= link_to "削除", recipe_path(recipe), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
    
   <p><%= image_tag recipe.image.url if recipe.image? %></p>
    
    <h2><%= link_to recipe.title, recipe_path(recipe) %></h2>
    <p>作成者: <%= recipe.user.name %></p>
    <p>作成日時：<%= recipe.created_at.strftime('%Y年%m月%d日') %></p>
    <hr>
  </div>  
<% end %>

<% if @recipes.empty? %>
  <p>まだレシピがありません</p>
<% else %>  
  <% @recipes.each do |recipe| %>
    <%= link_to "編集", edit_recipe_path(recipe) %> 
    <%= link_to "削除", recipe_path(recipe), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
    <div> 
      
      
      <h2><%= link_to recipe.title, recipe_path(recipe) %></h2>
      <p>作成者: <%= recipe.user.name %></p>
      <p>作成日時：<%= recipe.created_at.strftime('%Y年%m月%d日') %></p>
      <hr> 
    </div>
  <% end %>
<% end %>  
